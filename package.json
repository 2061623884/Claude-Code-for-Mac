{
  "name": "claude-desk",
  "productName": "Claude Code",
  "version": "0.1.1",
  "private": true,
  "description": "Codex 风格的中文 Claude Code 桌面应用",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "probe": "electron-vite build && env -u ELECTRON_RUN_AS_NODE electron . --probe",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test-web.json",
    "test": "vitest run",
    "install-app": "zsh scripts/install-app.sh",
    "rebuild-native": "electron-rebuild -f -w node-pty",
    "postinstall": "npm run rebuild-native"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@lexical/react": "0.52.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "diff": "9.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.3",
    "lexical": "0.52.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "local.nature.claude-desk",
    "productName": "Claude Code",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true
    }
  }
}
